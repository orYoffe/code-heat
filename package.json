{
  "name": "explorer-size-heatmap",
  "displayName": "Explorer Size Heatmap",
  "description": "Color files and folders by lines of code. Export a monorepo size report with the CLI.",
  "version": "0.1.0",
  "publisher": "oryoffe",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "lines",
    "monorepo",
    "explorer",
    "size",
    "heatmap"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "bin": {
    "code-size": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository",
    "test:integration": "node scripts/integration.js"
  },
  "dependencies": {
    "picomatch": "4.0.3"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "@vscode/test-electron": "2.5.2",
    "playwright": "1.58.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "explorerSizeHeatmap.refresh",
        "title": "Explorer Size Heatmap: Refresh"
      },
      {
        "command": "explorerSizeHeatmap.openConfig",
        "title": "Explorer Size Heatmap: Open Configuration"
      }
    ],
    "colors": [
      {
        "id": "explorerSizeHeatmap.level0",
        "description": "File and folder size heat level 0 of 20.",
        "defaults": {
          "dark": "#39FF14",
          "light": "#39FF14",
          "highContrast": "#39FF14",
          "highContrastLight": "#39FF14"
